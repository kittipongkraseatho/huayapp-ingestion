SOURCE_URL=https://huayapp.com/
REQUEST_TIMEOUT=20
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3
# Pick storage backend. When DATABASE_URL is set to a postgres://... URL
# the ingestion service writes to Postgres instead of SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_PATH=lottery.db
OUTPUT_DIRECTORY=output
LOG_LEVEL=INFO
BROWSER_HEADLESS=true
OCR_CONFIDENCE_THRESHOLD=0.70
# Override the in-process refresh loop interval (default 900s = 15 min).
# Should be >= 60s and larger than the time it takes to scrape 142 cards.
REFRESH_INTERVAL_SECONDS=900
